    "url": "https://github.com/DocsVision/WebClient-Samples.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@docsvision/web": "~5.17.0",
    "@docsvision/webclient": "~5.17.0",
    "@docsvision/webclient-extension-build": "~5.17.0",
    "concurrently": "^5.3.0",
    "@types/react": "17.0.3"
  },
  "overrides": {
    "@types/react": "17.0.3"
  }
}
